{
  "name": "technion-mpa",
  "version": "1.0.0",
  "description": "Technion - SMD PCB assembly. Multi-page site built with Vite, vanilla JS (ES modules) and modern CSS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lucide-static": "^1.59.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0"
  }
}
