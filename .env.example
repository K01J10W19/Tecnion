# Copy to .env.local (git-ignored) and fill in. Only VITE_-prefixed
# variables reach client code, so never put secrets here.

# POST endpoint for the order form (multipart/form-data). Leave empty to use
# the built-in demo submit: a simulated success with no network request.
VITE_ORDER_ENDPOINT=

# Artificial latency (ms) applied by src/scripts/services/* so loading states
# (skeletons, button spinners) are visible. .env.development sets it for local
# work; keep it unset or 0 in production.
VITE_SIMULATED_LATENCY=0
